<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vehicles.WpfApp"
        mc:Ignorable="d"
        Title="Vehicles" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="VehiclesListBox"
             Grid.Column="0"
             Margin="5"
             SelectionChanged="VehiclesListBox_SelectionChanged"/>

        <StackPanel Grid.Column="1" Margin="10">

            <TextBlock Text="Selected vehicle:"
                   FontWeight="Bold"/>

            <TextBlock x:Name="VehicleInfoText"
                   Margin="0,5,0,10"/>

            <TextBlock Text="Distance (km):"/>

            <TextBox x:Name="DistanceTextBox"
                 Width="100"
                 Margin="0,5,0,10"/>

            <WrapPanel Margin="0,5">

                <Button x:Name="AddCarButton"
                    Content="Add Car"
                    Width="90"
                    Margin="5"
                    Click="AddCarButton_Click"/>

                <Button x:Name="AddBoatButton"
                    Content="Add Boat"
                    Width="90"
                    Margin="5"
                    Click="AddBoatButton_Click"/>

                <Button x:Name="AddAmphibiousButton"
                    Content="Add Amphibious"
                    Width="120"
                    Margin="5"
                    Click="AddAmphibiousButton_Click"/>

            </WrapPanel>

            <WrapPanel Margin="0,5">

                <Button x:Name="DriveButton"
                    Content="Drive"
                    Width="90"
                    Margin="5"
                    Click="DriveButton_Click"/>

                <Button x:Name="SwimButton"
                    Content="Swim"
                    Width="90"
                    Margin="5"
                    Click="SwimButton_Click"/>

                <Button x:Name="DeleteButton"
                    Content="Delete"
                    Width="90"
                    Margin="5"
                    Click="DeleteButton_Click"/>



            </WrapPanel>

            <TextBlock Text="Log:"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

            <ListBox x:Name="LogListBox"
                 Height="150"/>

        </StackPanel>
    </Grid>
</Window>
