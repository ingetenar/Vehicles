<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vehicles.WpfApp"
        mc:Ignorable="d"
        Title="Vehicles" Height="450" Width="800">
	<Window.Background>
		<SolidColorBrush Color="#F5F7FA"/>
	</Window.Background>

	<Window.Resources>

		<Style TargetType="Button">
			<Setter Property="Background" Value="#DDEEFF"/>
			<Setter Property="BorderBrush" Value="#66A3FF"/>
			<Setter Property="Padding" Value="8.5"/>
			<Setter Property="Margin" Value="5"/>
		</Style>

		<Style TargetType="TextBlock">
			<Setter Property="FontSize" Value="14"/>
		</Style>

	</Window.Resources>

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">

            <ListBox x:Name="VehiclesListBox"
                 Height="230"
                 SelectionChanged="VehiclesListBox_SelectionChanged"/>

            <Button x:Name="AddCarButton"
                Content="Add Car"
                Width="120"
                Height="40"
                Click="AddCarButton_Click"/>

            <Button x:Name="AddBoatButton"
                Content="Add Boat"
                Width="120"
                Height="40"
                Click="AddBoatButton_Click"/>

            <Button x:Name="AddAmphibiousButton"
                Content="Add Amphibious"
                Width="120"
                Height="40"
                Click="AddAmphibiousButton_Click"/>

        </StackPanel>

        <StackPanel Grid.Column="1" Margin="15">

            <TextBlock Text="Selected vehicle:"
                   FontWeight="Bold"/>

            <TextBlock x:Name="VehicleInfoText"
                   Margin="0,5,0,20"/>

            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,15">

                <TextBlock Text="Distance (km):"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="DistanceTextBox"
                     Width="80"
                     Height="25"
                     Margin="10,0,0,0"/>

            </StackPanel>

            <WrapPanel Margin="0,0,0,15">

                <Button x:Name="DriveButton"
                    Content="Drive"
                    Width="80"
                    Height="35"
                    Margin="5"
                    Click="DriveButton_Click"/>

                <Button x:Name="SwimButton"
                    Content="Swim"
                    Width="80"
                    Height="35"
                    Margin="5"
                    Click="SwimButton_Click"/>

                <Button x:Name="DeleteButton"
                    Content="Delete"
                    Width="80"
                    Height="35"
                    Margin="5"
                    Background="Tomato"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="DeleteButton_Click"/>

            </WrapPanel>

            <TextBlock Text="Log:"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

            <ListBox x:Name="LogListBox"
                 Height="220"/>

        </StackPanel>

    </Grid>
</Window>
